# GapFinder AI Environment Variables

# Gemini API Configuration (Server-side)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Optional - falls back to local persistent repository)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Configuration
NEXT_PUBLIC_APP_NAME="GapFinder AI"
NEXT_PUBLIC_DEFAULT_SUBJECT="Computer Networks"
